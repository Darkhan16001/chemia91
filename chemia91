  padding:15px;
  background:#1e4b63;
  border-radius:9px;
  font-size:20px;
}
@media(max-width:850px){
  .grid2,.grid3,.options{
    grid-template-columns:1fr;
  }
  main{padding:15px}
  header,footer{padding:9px}
  .brand{font-size:17px}
  .brand small,#sectionName{display:none}
  .status{gap:8px;font-size:13px}
  #timer{font-size:21px}
  #clock{font-size:15px}
  .signature{font-size:14px}
  .btn{font-size:14px;padding:10px}
  .tools{bottom:78px}
  .model-buttons .btn{font-size:15px}
}
</style>
</head>

<body>
<div class="app">

<header>
  <div class="brand">
    ⚗ CHEMISTRY PRO
    <small>
      ХИМИЯЛЫҚ ТЕПЕ-ТЕҢДІК · ЛЕ ШАТЕЛЬЕ ПРИНЦИПІ
    </small>
  </div>

  <div class="status">
    <span id="sectionName">Кіріспе</span>
    <span id="timer">80:00</span>
    <span id="counter">1 / 29</span>
  </div>
</header>

<main id="main">
  <section class="slide" id="slide"></section>
</main>

<footer>
  <div class="actions" style="margin:0">
    <button class="btn" id="prev">← Артқа</button>
    <button class="btn primary" id="next">Келесі →</button>
  </div>

  <strong class="signature">BY DARKHAN</strong>
  <span id="clock">00:00:00</span>
</footer>

</div>

<div class="tools">
  <button class="tool" id="showCalc">
    🧮 Калькулятор
  </button>
  <button class="tool" id="showTable">
    ⚛ Менделеев кестесі
  </button>
</div>

<div class="calculator" id="calculator" hidden>
  <div class="calc-head">
    <strong>🧮 Калькулятор</strong>
    <button id="closeCalc">✕</button>
  </div>

  <input id="calcDisplay" readonly>
  <div class="calc-keys" id="calcKeys"></div>

  <div class="calc-hint">
    Кез келген жерінен ұстап жылжыт
  </div>
</div>

<div class="overlay" id="tableOverlay" hidden>
  <div class="modal">
    <div class="modal-head">
      <h2>Менделеев кестесі</h2>
      <button class="btn" id="closeTable">Жабу ✕</button>
    </div>

    <p>118 элемент · 18 топ · 7 период</p>

    <div class="period-scroll">
      <div class="period" id="period"></div>
    </div>

    <div id="elementInfo">
      Элементті таңда.
    </div>
  </div>
</div>

<script>
"use strict";

/* 1. БЕТТЕР МЕН НАВИГАЦИЯ */

const $ = id => document.getElementById(id);
const slides = [];
let page = 0;

function add(title, section, html) {
  slides.push({title, section, html});
}

function dynamic(title, section, render) {
  slides.push({title, section, render});
}

function draw() {
  const s = slides[page];
  if (!s) return;

  $("slide").innerHTML = s.render ? s.render() : s.html;
  $("sectionName").textContent = s.section;
  $("counter").textContent = `${page + 1} / ${slides.length}`;
  $("prev").disabled = page === 0;
  $("next").disabled = page === slides.length - 1;
  $("main").scrollTop = 0;
}

function go(title) {
  const i = slides.findIndex(s => s.title === title);
  if (i >= 0) {
    page = i;
    draw();
  }
}

$("prev").onclick = () => {
  if (page > 0) {
    page--;
    draw();
  }
};

$("next").onclick = () => {
  if (page < slides.length - 1) {
    page++;
    draw();
  }
};

/* 2. САҚТАУ */

const STORE = "darkhan_equilibrium_v2";

function initialState() {
  return {
    factor:0,
    levels:{},
    oral:0,
    oralShow:false,
    game:0,
    choice:null,
    scores:[0,0,0],
    home:false
  };
}

let state = initialState();

try {
  const saved = JSON.parse(localStorage.getItem(STORE));
  if (saved && Array.isArray(saved.scores) &&
      saved.scores.length === 3) {
    state = {...initialState(), ...saved};
  }
} catch(e) {
  console.warn(e);
}

function save() {
  try {
    localStorage.setItem(STORE, JSON.stringify(state));
  } catch(e) {
    console.warn(e);
  }
}

/* 3. КІРІСПЕ СУРЕТІ */

function equilibriumDiagram() {
  return `
  <div class="visual">
    <svg viewBox="0 0 560 245">
      <g fill="#255670" stroke="#9ce4ff" stroke-width="4">
        <circle cx="110" cy="105" r="55"/>
        <circle cx="365" cy="105" r="42"/>
        <circle cx="448" cy="105" r="42"/>
      </g>

      <g fill="white" font-size="27"
         font-weight="bold" text-anchor="middle">
        <text x="110" y="115">N₂O₄</text>
        <text x="365" y="114">NO₂</text>
        <text x="448" y="114">NO₂</text>
      </g>

      <g stroke="#ffdc92" stroke-width="6"
         stroke-linecap="round">
        <line x1="190" y1="90" x2="276" y2="90"/>
        <line x1="190" y1="125" x2="276" y2="125"/>
      </g>

      <g fill="#ffdc92">
        <polygon points="276,90 256,79 256,101"/>
        <polygon points="190,125 210,114 210,136"/>
      </g>

      <text x="280" y="201"
        fill="#9cf0c9" font-size="25"
        font-weight="bold" text-anchor="middle">
        ТУРА ⇌ КЕРІ
      </text>
    </svg>

    <strong>Динамикалық тепе-теңдік</strong>
    <p>
      Тура және кері реакциялар
      бір уақытта жүреді.
    </p>
  </div>`;
}

/* 4. КІРІСПЕ */

dynamic("Кіріспе", "Кіріспе · 5 минут", () => `
  <div class="grid2">
    <div>
      <div class="eyebrow">ХИМИЯ · 1-КУРС</div>

      <h1>
        Химиялық тепе-теңдік.
        Тепе-теңдікке әсер ететін факторлар
      </h1>

      <p>
        Қайтымды реакциялар, динамикалық тепе-теңдік,
        Ле Шателье принципі, концентрация,
        температура, қысым және катализатор.
      </p>

      <div class="formula">A + B ⇌ C + D</div>

      <div class="actions">
        <button class="btn good" data-act="start">
          ▶ Сабақты бастау
        </button>
        <button class="btn gold" data-act="reset-time">
          ↺ Таймерді жаңарту
        </button>
      </div>
    </div>

    ${equilibriumDiagram()}
  </div>
`);

add("Сабақ мақсаты", "Кіріспе", `
  <h2>Сабақтың мақсаты</h2>

  <div class="grid2">
    <div class="card">
      <h3>Білімдік мақсат</h3>
      <p>
        Қайтымды реакцияны, химиялық тепе-теңдікті,
        тепе-теңдік константасын және
        Ле Шателье принципін түсіну.
      </p>
    </div>

    <div class="card">
      <h3>Практикалық мақсат</h3>
      <p>
        Концентрация, температура және қысым
        өзгергенде тепе-теңдіктің ығысуын анықтау.
        Тепе-теңдік константасы арқылы есептер шығару.
      </p>
    </div>
  </div>

  <div class="note">
    <p>
      Сабақ ұзақтығы — 80 минут.
      Теория — 20 минут.
      Конспект — 8 минут.
      Деңгейлік жұмыс — 10 минут.
      Жеке тапсырмалар — 20 минут.
      Командалық ойын — 12 минут.
      Кіріспе мен қорытынды — 10 минут.
    </p>
  </div>
`);

/* 5. 15 ТҮСІНДІРМЕ */

const theory = [
  [
    "Қайтымды реакциялар",
    "Қайтымды реакциялар белгілі жағдайларда тура және кері бағытта жүре алады. Тура реакция бастапқы заттардан өнімдер түзеді, ал кері реакция өнімдерден бастапқы заттарды түзеді. Мұндай реакция екі жақты көрсеткімен белгіленеді.",
    "A + B ⇌ C + D",
    "Қайтымды реакция екі бағытта жүреді."
  ],
  [
    "Қайтымды және қайтымсыз реакциялар",
    "Қайтымсыз деп белгілі жағдайда бір бағытта басым жүретін реакцияларды атаймыз. Қайтымды реакцияда тура және кері процестер қатар жүруі мүмкін. Қайтымдылықты нақты реакцияның жүру жағдайларын ескере отырып түсіндіреміз.",
    "→ және ⇌",
    "⇌ — қайтымды реакцияның белгісі."
  ],
