
<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Химиялық тепе-теңдік | CHEMISTRY PRO</title>

<style>
:root{
  --bg:#071725;
  --panel:#12364d;
  --panel2:#20526a;
  --text:#f5fbff;
  --blue:#9be4ff;
  --green:#9df1c4;
  --yellow:#ffe29c;
  --red:#ff9eab;
  --line:#81b5cb;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%}
body{
  font-family:"Segoe UI",Arial,sans-serif;
  color:var(--text);
  background:var(--bg);
}
button,input{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.45;cursor:default}
[hidden]{display:none!important}
.app{
  display:flex;
  flex-direction:column;
  height:100vh;
  height:100dvh;
  background:
    radial-gradient(circle at 90% 8%,#159db055,transparent 45%),
    radial-gradient(circle at 5% 95%,#15936b44,transparent 45%),
    linear-gradient(125deg,#071725,#173f57,#081e30);
}
header,footer{
  flex-shrink:0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:10px 20px;
  background:#081f30;
}
header{border-bottom:1px solid var(--line)}
footer{border-top:1px solid var(--line)}
.brand{
  font-size:27px;
  font-weight:900;
  color:var(--blue);
}
.brand small{
  display:block;
  font-size:13px;
  color:var(--yellow);
