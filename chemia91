const elements = elementData.trim()
  .split(/\s+/)
  .map((entry,i) => {
    const [symbol,name] = entry.split("|");
    return {z:i+1,symbol,name};
  });

const groups = [
  [1,18],
  [1,2,13,14,15,16,17,18],
  [1,2,13,14,15,16,17,18],
  Array.from({length:18},(_,i)=>i+1),
  Array.from({length:18},(_,i)=>i+1)
];

function position(z) {
  if (z <= 54) {
    let k=z-1;
    for (let p=0;p<5;p++) {
      if (k < groups[p].length) {
        return {row:p+1,col:groups[p][k]};
      }
      k-=groups[p].length;
    }
  }

  if (z <= 56) return {row:6,col:z-54};
  if (z <= 71) return {row:9,col:z-53};
  if (z <= 86) return {row:6,col:z-68};
  if (z <= 88) return {row:7,col:z-86};
  if (z <= 103) return {row:10,col:z-85};
  return {row:7,col:z-100};
}

function buildTable() {
  let html="";

  for (let g=1;g<=18;g++) {
    html+=`
      <span class="period-label"
        style="grid-row:1;grid-column:${g+1}">
        ${g}
      </span>`;
  }

  for (let p=1;p<=7;p++) {
    html+=`
      <span class="period-label"
        style="grid-row:${p+1};grid-column:1">
        ${p}
      </span>`;
  }

  html+=`
    <span class="period-label"
      style="grid-row:10;grid-column:1">La–Lu</span>
    <span class="period-label"
      style="grid-row:11;grid-column:1">Ac–Lr</span>
    <span class="period-label"
      style="grid-row:7;grid-column:4">57–71</span>
    <span class="period-label"
      style="grid-row:8;grid-column:4">89–103</span>
  `;

  for (const el of elements) {
    const p=position(el.z);
    const f=(el.z>=57&&el.z<=71) ||
            (el.z>=89&&el.z<=103);
    const featured=["H","N","O","C"].includes(el.symbol);

    html+=`
      <button
        class="element ${f?"fblock":featured?"featured":""}"
        data-z="${el.z}"
        style="grid-row:${p.row+1};grid-column:${p.col+1}">
        <i>${el.z}</i>
        <b>${el.symbol}</b>
        <small>${el.name}</small>
      </button>
    `;
  }

  $("period").innerHTML=html;
}

$("period").addEventListener("click",event=>{
  const b=event.target.closest("[data-z]");
  if(!b)return;

  const z=Number(b.dataset.z);
  const el=elements[z-1];
  const p=position(z);

  const period=p.row===9?6:p.row===10?7:p.row;
  const group=p.row>7?"f-блок":p.col+"-топ";

  $("elementInfo").textContent=
    `${z}. ${el.name} (${el.symbol}) · `+
    `${period}-период · ${group}`;
});

$("showTable").onclick=()=>{
  $("tableOverlay").hidden=false;
};

$("closeTable").onclick=()=>{
  $("tableOverlay").hidden=true;
};

$("tableOverlay").onclick=event=>{
  if(event.target===$("tableOverlay")){
    $("tableOverlay").hidden=true;
  }
};

/* 18. ПЕРНЕТАҚТА БАСҚАРУЫ */

document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){
    $("tableOverlay").hidden=true;
    calculator.hidden=true;
    return;
  }

  if(!$("tableOverlay").hidden)return;
  if(event.target.closest("input,textarea"))return;

  if(event.key==="ArrowRight"&&page<slides.length-1){
    page++;
    draw();
  }else if(event.key==="ArrowLeft"&&page>0){
    page--;
    draw();
  }
});

