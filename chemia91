$("slide").addEventListener("click", event => {
  const b = event.target.closest("[data-act]");
  if (!b) return;

  const action = b.dataset.act;
  const i = Number(b.dataset.i);

  switch(action) {
    case "start":
      startTimer();
      break;

    case "reset-time":
      resetTimer();
      break;

    case "factor":
      state.factor = i;
      break;

    case "level":
      state.levels[i] = !state.levels[i];
      break;

    case "oral-show":
      state.oralShow = !state.oralShow;
      break;

    case "oral-next":
      state.oral = Math.min(oral.length, state.oral+1);
      state.oralShow = false;
      break;

    case "oral-reset":
      state.oral = 0;
      state.oralShow = false;
      break;

    case "to-game":
      go("Командалық ойын");
      break;

    case "answer":
      if (state.choice !== null) return;
      if (i < 0 || i > 3) return;
      state.choice = i;
      if (i === quiz[state.game][2]) {
        state.scores[state.game%3] += 10;
      }
      break;

    case "game-next":
      if (state.choice === null) return;
      state.game++;
      state.choice = null;
      break;

    case "game-reset":
      state.game = 0;
      state.choice = null;
      state.scores = [0,0,0];
      break;

    case "home":
      state.home = !state.home;
      break;
  }

  save();
  draw();
});

