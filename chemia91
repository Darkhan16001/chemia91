.calc-hint{
  padding-top:9px;
  text-align:center;
  color:#d7e8f0;
  font-size:12px;
}

/* МЕНДЕЛЕЕВ КЕСТЕСІ */
.overlay{
  position:fixed;
  inset:0;
  z-index:300;
  display:grid;
  place-items:center;
  padding:10px;
