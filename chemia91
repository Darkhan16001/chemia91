const keys = [
  "7","8","9","/",
  "4","5","6","*",
  "1","2","3","-",
  "C","0",".","+",
  "(",")","⌫","="
];

$("calcKeys").innerHTML = keys.map(k => `
  <button type="button" data-key="${k}">
    ${k === "/" ? "÷" : k === "*" ? "×" : k}
  </button>
`).join("");

let calcText = "";

function calculate(input) {
  let i = 0;

  function factor() {
    if (input[i] === "+") {
      i++;
      return factor();
    }

    if (input[i] === "-") {
      i++;
      return -factor();
    }

    if (input[i] === "(") {
      i++;
      const value = sum();
      if (input[i] !== ")") throw Error("Жақша қатесі");
      i++;
      return value;
    }

    const m = /^(?:\d+\.?\d*|\.\d+)/.exec(input.slice(i));
    if (!m) throw Error("Сан қатесі");
    i += m[0].length;
    return Number(m[0]);
  }

  function product() {
    let value = factor();

    while (input[i] === "*" || input[i] === "/") {
      const op = input[i++];
      const next = factor();
      value = op === "*" ? value*next : value/next;
    }

    return value;
  }

  function sum() {
    let value = product();

    while (input[i] === "+" || input[i] === "-") {
      const op = input[i++];
      const next = product();
      value = op === "+" ? value+next : value-next;
    }

    return value;
  }

  if (!/^[0-9+*/().-]+$/.test(input)) {
    throw Error("Таңба қатесі");
  }

  const result = sum();

  if (i !== input.length || !Number.isFinite(result)) {
    throw Error("Өрнек қатесі");
  }

  return Number(result.toPrecision(12));
}

$("calcKeys").addEventListener("click", event => {
  const b = event.target.closest("[data-key]");
  if (!b) return;

  const k = b.dataset.key;

  if (k === "C") {
    calcText = "";
  } else if (k === "⌫") {
    calcText = calcText.slice(0,-1);
  } else if (k === "=") {
    try {
      calcText = String(calculate(calcText));
    } catch(e) {
      calcText = "Қате";
    }
  } else {
    if (calcText === "Қате") calcText = "";
    calcText += k;
  }

  $("calcDisplay").value = calcText;
});

/* 16. КАЛЬКУЛЯТОРДЫ КЕЗ КЕЛГЕН
   ЖЕРІНЕН ҰСТАП ҚОЗҒАЛТУ */

function clamp(v,min,max) {
  return Math.max(min,Math.min(max,v));
}

function fitCalculator() {
  if (calculator.hidden) return;

  const r = calculator.getBoundingClientRect();

  calculator.style.left = clamp(
    r.left,
    0,
    Math.max(0,window.innerWidth-r.width)
  ) + "px";

  calculator.style.top = clamp(
    r.top,
    0,
    Math.max(0,window.innerHeight-r.height)
  ) + "px";
}

let drag = null;
let blockClickUntil = 0;

/*
  Pointerdown калькулятордың өзіне қойылған.
  Сондықтан сан батырмалары, экран,
  бос орындар және шеттері де ұсталады.

  Pointer capture басылған нақты элементте
  сақталады. Бұл жай басылған санның
  click оқиғасын дұрыс жеткізеді.
*/

calculator.addEventListener("pointerdown", event => {
  if (drag) return;

  if (event.pointerType === "mouse" &&
      event.button !== 0) return;

  const r = calculator.getBoundingClientRect();

  drag = {
    id:event.pointerId,
    target:event.target,
    startX:event.clientX,
    startY:event.clientY,
    left:r.left,
    top:r.top,
    moved:false
  };

  if (typeof event.target.setPointerCapture === "function") {
    event.target.setPointerCapture(event.pointerId);
  }
});

calculator.addEventListener("pointermove", event => {
  if (!drag || event.pointerId !== drag.id) return;

  const dx = event.clientX-drag.startX;
  const dy = event.clientY-drag.startY;

  if (Math.hypot(dx,dy) > 5) {
    drag.moved = true;
  }

  if (!drag.moved) return;

  calculator.classList.add("dragging");

  calculator.style.left = clamp(
    drag.left+dx,
    0,
    Math.max(0,window.innerWidth-calculator.offsetWidth)
  ) + "px";

  calculator.style.top = clamp(
    drag.top+dy,
    0,
    Math.max(0,window.innerHeight-calculator.offsetHeight)
  ) + "px";
});

function stopDragging(event) {
  if (!drag || event.pointerId !== drag.id) return;

  if (drag.moved) {
    blockClickUntil = performance.now()+400;
  }

  if (
    drag.target &&
    typeof drag.target.hasPointerCapture === "function" &&
    drag.target.hasPointerCapture(event.pointerId)
  ) {
    drag.target.releasePointerCapture(event.pointerId);
  }

  drag = null;
  calculator.classList.remove("dragging");
}

calculator.addEventListener("pointerup",stopDragging);
calculator.addEventListener("pointercancel",stopDragging);

/*
  Калькулятор қозғалған соң
  кездейсоқ сан немесе жабу
  батырмасы басылып кетпейді.
*/
calculator.addEventListener("click",event => {
  if (performance.now() >= blockClickUntil) return;

  event.preventDefault();
  event.stopImmediatePropagation();
  blockClickUntil = 0;
