const TIMER_KEY = STORE + "_timer";
let deadline = null;

try {
  const saved = localStorage.getItem(TIMER_KEY);
  if (saved !== null && Number.isFinite(Number(saved))) {
    deadline = Number(saved);
  }
} catch(e) {
  console.warn(e);
}

function tick() {
  const seconds = deadline === null
    ? 4800
    : Math.max(0, Math.ceil((deadline-Date.now())/1000));

  $("timer").textContent =
    String(Math.floor(seconds/60)).padStart(2,"0") +
    ":" +
    String(seconds%60).padStart(2,"0");

  $("clock").textContent =
    new Intl.DateTimeFormat("en-GB",{
      timeZone:"Asia/Almaty",
      hour:"2-digit",
      minute:"2-digit",
      second:"2-digit",
      hourCycle:"h23"
    }).format(new Date());
}

function startTimer() {
  if (deadline !== null) {
    alert("Таймер іске қосылған.");
    return;
  }

  deadline = Date.now() + 4800000;

  try {
    localStorage.setItem(TIMER_KEY, String(deadline));
  } catch(e) {
    console.warn(e);
  }

  tick();
}

function resetTimer() {
  if (!confirm("80 минуттық таймерді жаңартамыз ба?")) return;
  deadline = null;

  try {
    localStorage.removeItem(TIMER_KEY);
  } catch(e) {
    console.warn(e);
  }

  tick();
}

