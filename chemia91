  border:1px solid var(--line);
  border-radius:6px;
  font-size:12px;
  font-weight:900;
}
.element{
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:3px;
  padding:14px 2px 3px;
  background:#2a607b;
  color:white;
  border:1px solid var(--line);
  border-radius:6px;
}
.element i{
  position:absolute;
  left:4px;
  top:3px;
  font-size:11px;
  font-style:normal;
}
.element b{font-size:25px}
.element small{font-size:11px}
.element.fblock{background:#347b81}
.element.featured{background:#91556c}
#elementInfo{
