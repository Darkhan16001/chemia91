}
.tool{
  padding:12px 13px;
  background:#087f9e;
  color:white;
  border:1px solid #9dd8ed;
  border-radius:9px;
  font-size:14px;
  font-weight:900;
}

/* КАЛЬКУЛЯТОР — БАРЛЫҚ ЖЕРІ ҚОЗҒАЛАДЫ */
.calculator{
  position:fixed;
  z-index:160;
  top:110px;
  left:18px;
  width:245px;
  max-width:calc(100vw - 12px);
  padding:11px;
  border:2px solid #9de0f4;
  border-radius:16px;
  background:#103149;
  box-shadow:0 20px 50px #0009;

  /* Барлық бөлігінен қозғалту */
  touch-action:none;
  user-select:none;
  cursor:grab;
}
.calculator.dragging{
  cursor:grabbing;
  border-color:var(--yellow);
  box-shadow:0 25px 60px #000d;
}
.calculator *{
  touch-action:none;
  user-select:none;
}
.calc-head{
